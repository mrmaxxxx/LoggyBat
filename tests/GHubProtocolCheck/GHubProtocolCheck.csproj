<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain console check of the widget's G HUB parsing, run in CI before packaging.
       It compiles the widget's GHubProtocol.cs directly, so no WinUI is needed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\LoggyBat\GHubProtocol.cs" Link="GHubProtocol.cs" />
  </ItemGroup>

</Project>
